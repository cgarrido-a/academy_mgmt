<%= form_with model: [:admin, user], local: true do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-error">
      <h3><%= pluralize(user.errors.count, "error") %> impidieron guardar este usuario:</h3>
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-error">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="form-group">
    <%= label_tag :roles_select, "Rol" %>
    <small style="display: block; color: #7f8c8d; margin-bottom: 0.5rem;">
      Un usuario puede tener más de un rol (por ejemplo, docente y administrador):
      volvé a editarlo para agregar otro. Los roles ya asignados no se pueden
      quitar desde aquí.
    </small>
    <select id="roles_select" name="user[roles][]" onchange="toggleRoleFields()">
      <option value="">Seleccionar rol</option>
      <% ApplicationHelper::USER_ROLES.each do |role| %>
        <% already = assigned_role_keys(user).include?(role[:key]) %>
        <option value="<%= role[:key] %>" <%= 'disabled' if already %>>
          <%= role[:label] %><%= already ? ' (ya asignado)' : '' %>
        </option>
      <% end %>
    </select>
  </div>

  <div class="form-group">
    <%= f.label :name, "Nombre" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :password, "Contraseña" %>
    <%= f.password_field :password, required: user.new_record?, placeholder: user.new_record? ? "" : "Dejar en blanco para mantener la actual" %>
    <% if user.persisted? %>
      <small style="color: #7f8c8d;">Dejar en blanco si no deseas cambiar la contraseña</small>
    <% end %>
  </div>

  <!-- Estudiante: se pide el contacto del apoderado en vez del teléfono normal. -->
  <div id="student_fields" style="display: none;">
    <div class="form-group">
      <%= f.label :guardian_email, "Email del apoderado" %>
      <%= f.email_field :guardian_email, placeholder: "apoderado@ejemplo.cl" %>
    </div>

    <div class="form-group">
      <%= f.label :guardian_phone, "Teléfono del apoderado" %>
      <%= f.telephone_field :guardian_phone, placeholder: "+56 9 1234 5678" %>
    </div>
  </div>

  <!-- Cualquier otro rol (o ninguno todavía): teléfono normal del usuario. -->
  <div id="normal_phone_field" style="display: none;">
    <div class="form-group">
      <%= f.label :phone, "Teléfono" %>
      <%= f.telephone_field :phone, placeholder: "+56 9 1234 5678" %>
    </div>
  </div>

  <div id="teacher_fields" style="display: none;">
    <div class="form-group">
      <%= label_tag 'user[profession]', "Profesión (para docentes)" %>
      <%= text_field_tag 'user[profession]', user.teacher&.profession, placeholder: "Ej: Ingeniera, Licenciada, etc." %>
    </div>
  </div>

  <div id="admin_fields" style="display: none;">
    <div class="form-group">
      <%= label_tag 'user[admin_type]', "Tipo de Admin" %>
      <%= select_tag 'user[admin_type]', options_for_select([
        ['Seleccionar tipo', ''],
        ['Super Admin', 'super'],
        ['Admin Regular', 'regular']
      ], user.admin_user&.admin_type) %>
    </div>
  </div>

  <script>
    // Roles que el usuario YA tiene (el select solo sirve para agregar uno
    // nuevo, así que estos flags no dependen de lo que esté elegido en él).
    var alreadyTeacher = <%= assigned_role_keys(user).include?('teacher').to_s %>;
    var alreadyStudent = <%= assigned_role_keys(user).include?('student').to_s %>;
    var alreadyAdmin = <%= assigned_role_keys(user).include?('admin').to_s %>;

    function toggleRoleFields() {
      var selectedRole = document.getElementById('roles_select').value;
      var isTeacher = alreadyTeacher || selectedRole === 'teacher';
      var isStudent = alreadyStudent || selectedRole === 'student';
      var isAdmin = alreadyAdmin || selectedRole === 'admin';

      document.getElementById('teacher_fields').style.display = isTeacher ? 'block' : 'none';
      document.getElementById('admin_fields').style.display = isAdmin ? 'block' : 'none';
      document.getElementById('student_fields').style.display = isStudent ? 'block' : 'none';

      // Teléfono normal: para todo lo que no sea estudiante. Si ya tiene un
      // teléfono guardado se muestra igual, para no esconder datos existentes.
      var hasPhone = <%= user.phone.present?.to_s %>;
      document.getElementById('normal_phone_field').style.display = (!isStudent || hasPhone) ? 'block' : 'none';
    }
    document.addEventListener('DOMContentLoaded', toggleRoleFields);
  </script>

  <div class="actions">
    <%= f.submit user.new_record? ? "Crear Usuario" : "Actualizar Usuario", class: "btn btn-success" %>
    <%= link_to "Cancelar", admin_users_path, class: "btn btn-secondary" %>
  </div>
<% end %>
