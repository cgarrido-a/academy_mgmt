<%= form_with model: [:admin, class_discount], local: true do |f| %>
  <% if class_discount.errors.any? %>
    <div class="alert alert-error">
      <h3><%= pluralize(class_discount.errors.count, "error") %> impidieron guardar este tramo:</h3>
      <ul>
        <% class_discount.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :number_of_classes, "Desde (cantidad de clases)" %>
    <%= f.number_field :number_of_classes, required: true, min: 1, placeholder: "Ej: 8, 12, 16, 24" %>
    <small style="color: #666;">Se aplica a compras con este total de clases o más (hasta el siguiente tramo).</small>
  </div>

  <div class="form-group">
    <%= f.label :discount_percentage, "Descuento (%)" %>
    <%= f.number_field :discount_percentage, required: true, min: 0, max: 100, placeholder: "Ej: 10, 15, 20" %>
    <small style="color: #666;">Porcentaje de descuento sobre el precio base por clase (0-100).</small>
  </div>

  <div class="actions">
    <%= f.submit "Guardar", class: "btn btn-success" %>
    <%= link_to "Cancelar", admin_class_discounts_path, class: "btn btn-secondary" %>
  </div>
<% end %>
